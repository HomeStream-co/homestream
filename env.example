# ══════════════════════════════════════════════════════════════════════════════
# HomeStream — Environment Variables
# Copy this file to .env and fill in your values.
# All variables are optional unless marked REQUIRED.
#
# Data files created automatically on first run (in the app directory):
#   media-library.json        — your scanned media library
#   homestream-profiles.json  — user profiles (up to 6)
#   homestream-watchlist.json — per-profile My List / watchlists
#   homestream-config.json    — app configuration (set via Setup wizard)
#   crash-log.json            — last 100 crash events (debug)
#
# Demo content: Big Buck Bunny is included as a demo item and streams from
# the internet (download.blender.org). It will not play in offline/LAN-only
# mode. Add your own video files to use HomeStream fully offline.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────

# Port the HomeStream server listens on (default: 3000)
PORT=3000

NODE_ENV=production

# ── Media Library ─────────────────────────────────────────────────────────────

# [REQUIRED for Docker] Absolute path to your video library on the host machine.
# This is mounted into the container at /media.
# Example: /mnt/raid/media  or  /home/user/Movies
MEDIA_DIR=/media

# ── Security ──────────────────────────────────────────────────────────────────

# Admin password to protect the HomeStream UI.
# Leave blank to allow open access (fine for trusted home networks).
# Set a strong password if exposing HomeStream to the internet.
ADMIN_PASSWORD=

# ── Metadata API Keys (all free tiers) ────────────────────────────────────────

# OMDB — movie/TV metadata, posters, ratings, plot summaries
# Get a free key at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# TMDB — additional metadata, backdrops, trending/upcoming data
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── AI Features ───────────────────────────────────────────────────────────────

# Google Gemini — AI enrichment (tags, mood, themes) + chat recommendations
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# AI provider: "gemini" (cloud, default) or "ollama" (fully local)
AI_PROVIDER=gemini

# Ollama — only needed if AI_PROVIDER=ollama
# Run Ollama locally: https://ollama.com
OLLAMA_URL=
OLLAMA_MODEL=llama3

# ── Security Scanning ─────────────────────────────────────────────────────────

# VirusTotal — hash-based malware scan on downloaded files (free tier: 4 req/min)
# Get a free key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ── qBittorrent Integration (optional) ────────────────────────────────────────

# Connect HomeStream to a running qBittorrent instance for managed downloads.
# qBittorrent Web UI URL (e.g. http://localhost:8080 or http://192.168.1.100:8080)
QBITTORRENT_URL=
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

# ── Jellyfin Integration (optional) ───────────────────────────────────────────

# Connect to a Jellyfin server for TV app compatibility (Roku, Fire TV, etc.)
JELLYFIN_URL=
JELLYFIN_API_KEY=
