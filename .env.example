# HomeStream — Local Configuration
# Copy this file to .env and fill in your values.
# The setup wizard (http://localhost:3000/setup) will also write these for you.
#
# NOTE: When running as the .exe installer, API keys are saved through the
# wizard UI and stored in %APPDATA%\HomeStream — you do NOT need a .env file.
# This file is only needed if you're running HomeStream from source (npm run dev).

# ── Required for metadata & artwork ──────────────────────────────────────────
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Optional: AI chat panel ───────────────────────────────────────────────────
# Google Gemini — https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# ── Optional: qBittorrent (for the download pipeline) ────────────────────────
QBIT_URL=http://localhost:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=homestream

# ── Optional: Jellyfin (for TV app compatibility) ────────────────────────────
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=

# ── Optional: Media folder (overrides wizard setting) ────────────────────────
# MEDIA_DIR=/path/to/your/media

# ── Optional: Admin password (overrides wizard setting) ──────────────────────
# ADMIN_PASSWORD=changeme
