# ── HomeStream Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.

# ── Media Storage ─────────────────────────────────────────────────────────────
# Path to your media folder on the HOST machine.
# RAID/NAS users: set this to your mount point, e.g. /mnt/raid/media
# The folder will be created automatically if it doesn't exist.
MEDIA_DIR=./media

# ── Ports (change if something is already using these) ────────────────────────
HOMESTREAM_PORT=3000
QBIT_WEBUI_PORT=8080
QBIT_TORRENT_PORT=6881
JELLYFIN_PORT=8096
JELLYFIN_HTTPS_PORT=8920

# ── Timezone ──────────────────────────────────────────────────────────────────
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# ── User/Group IDs (Linux/Mac only — keeps file permissions correct) ──────────
# Run `id` in terminal to find your UID/GID
PUID=1000
PGID=1000

# ── qBittorrent ───────────────────────────────────────────────────────────────
# Default credentials for qBittorrent Web UI
# IMPORTANT: Change these before exposing to the internet
QBIT_USERNAME=admin
QBIT_PASSWORD=homestream

# ── HomeStream Admin ──────────────────────────────────────────────────────────
# Password for the HomeStream admin panel
ADMIN_PASSWORD=changeme

# ── Jellyfin ──────────────────────────────────────────────────────────────────
# Get this from Jellyfin Dashboard → API Keys after first-run setup
JELLYFIN_API_KEY=
# Your server's public URL (used for external access)
JELLYFIN_PUBLIC_URL=http://localhost:8096

# ── Optional API Keys ─────────────────────────────────────────────────────────
# OMDB: Movie metadata (posters, plot, ratings) — free at https://www.omdbapi.com
OMDB_API_KEY=
# Google AI: AI enrichment (tags, mood, summaries) — free tier at https://aistudio.google.com
GOOGLE_AI_API_KEY=

# ── Setup ─────────────────────────────────────────────────────────────────────
# Set to "true" after the setup wizard completes (done automatically)
SETUP_COMPLETE=false
